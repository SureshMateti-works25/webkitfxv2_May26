{
  "name": "webkitfxv2-may26",
  "private": true,
  "version": "0.1.0",
  "description": "webkitfxv2 — JSON layout, validation, and condition engine workspace",
  "workspaces": [
    "packages/core-engine",
    "packages/react-renderer",
    "apps/demo",
    "apps/sarees",
    "apps/groceries"
  ],
  "scripts": {
    "build": "npm run build -w @webkitfxv2/core-engine && npm run build -w @webkitfxv2/react-renderer",
    "build:demo": "npm run build && npm run build -w webkitfxv2-demo",
    "build:sarees": "npm run build && npm run build -w sarees-market",
    "build:groceries": "npm run build && npm run build -w groceries-market",
    "dev": "npm run build && npm run dev -w webkitfxv2-demo",
    "dev:sarees": "npm run build && npm run dev -w sarees-market",
    "dev:groceries": "npm run build && npm run dev -w groceries-market",
    "dev:sarees:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-sarees-stack.ps1",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-sarees-stack.ps1",
    "stop:commerce-api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-commerce-api.ps1",
    "api:commerce:exec:fresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-commerce-api.ps1 -StopExisting",
    "api:commerce:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-commerce-api-watch.ps1",
    "docker:commerce-db": "docker compose -f services/commerce-api/docker-compose.yml up -d",
    "test": "npm run test -w @webkitfxv2/core-engine",
    "check": "npm run build && npm run test",
    "git:push": "node scripts/push-working.mjs",
    "api:commerce": "dotnet run --project services/commerce-api/Commerce.Api/Commerce.Api.csproj",
    "api:commerce:exec": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-commerce-api.ps1",
    "api:catalog": "npm run api:commerce",
    "test:commerce-api": "node scripts/commerce-api-smoke.mjs",
    "test:commerce-api:auth": "node scripts/commerce-api-smoke.mjs auth",
    "test:commerce-api:catalog": "node scripts/commerce-api-smoke.mjs catalog",
    "test:catalog-api": "npm run test:commerce-api",
    "test:catalog-api:auth": "npm run test:commerce-api:auth",
    "test:catalog-api:catalog": "npm run test:commerce-api:catalog",
    "seed:commerce:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-commerce-remote.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
