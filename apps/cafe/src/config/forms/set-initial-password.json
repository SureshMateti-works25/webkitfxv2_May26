{
  "id": "set-initial-password",
  "title": "Set your password",
  "layout": {
    "type": "stack",
    "axis": "vertical",
    "gap": "1rem",
    "children": [
      { "type": "field", "fieldId": "newPassword" },
      { "type": "field", "fieldId": "confirmPassword" }
    ]
  },
  "fields": {
    "newPassword": {
      "binding": "password.new",
      "widget": "password",
      "label": "New password",
      "props": { "autoComplete": "new-password" },
      "default": "",
      "rules": [{ "kind": "required" }, { "kind": "minLength", "value": 8 }]
    },
    "confirmPassword": {
      "binding": "password.confirm",
      "widget": "password",
      "label": "Confirm new password",
      "props": { "autoComplete": "new-password" },
      "default": "",
      "rules": [
        { "kind": "required" },
        { "kind": "eqPath", "path": "password.new", "message": "Must match new password" }
      ]
    }
  }
}
