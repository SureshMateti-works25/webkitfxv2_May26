{
  "id": "chrome-notice",
  "title": "Chrome notice bar",
  "layout": {
    "type": "stack",
    "axis": "vertical",
    "gap": "0",
    "children": [{ "type": "field", "fieldId": "noticeMessage" }]
  },
  "fields": {
    "noticeMessage": {
      "binding": "notice.message",
      "widget": "marqueeNotice",
      "label": "Notice",
      "default": "Order for pickup or dine-in · Scan your table QR to order · Track prep status on the kitchen queue",
      "props": {
        "ariaLabel": "Café announcements",
        "repeatCount": 2
      }
    }
  }
}
