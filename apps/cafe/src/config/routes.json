{
  "version": "1",
  "routes": [
    { "path": "/", "implementation": "home" },
    { "path": "/qr/:tableCode", "implementation": "qrTableMenu" },
    { "path": "/qr", "implementation": "qrTableMenu" },
    { "path": "/browse/:categorySlug", "implementation": "categoryBrowse" },
    { "path": "/p/:productSlug", "implementation": "productDetail" },
    { "path": "/productDetail/:productKey", "implementation": "productDetail" },
    { "path": "/cart", "implementation": "cart" },
    { "path": "/checkout", "implementation": "checkout" },
    { "path": "/checkout/payment", "implementation": "checkoutPayment" },
    { "path": "/checkout/confirmation/:orderId", "implementation": "orderConfirmation" },
    { "path": "/search", "implementation": "search" },
    { "path": "/login", "implementation": "login" },
    { "path": "/forgot-password", "implementation": "forgotPassword" },
    { "path": "/account/change-password", "implementation": "changePassword" },
    { "path": "/signup/vendor", "implementation": "vendorSignup" },
    { "path": "/signup/shopper", "implementation": "shopperSignup" },
    { "path": "/settings", "template": "shellCopy", "screen": "settings" },
    { "path": "/settings/notifications", "template": "shellCopy", "screen": "settings" },
    { "path": "/account/profile", "implementation": "profile" },
    { "path": "/vendor/products", "implementation": "vendorProducts" },
    { "path": "/vendor/products/:productId/storefront", "implementation": "vendorProductStorefront" },
    { "path": "/vendor/products/:productId", "implementation": "vendorProductEdit" },
    { "path": "/admin/lookups", "implementation": "lookupAdmin" },
    { "path": "/admin/storefront-ads", "implementation": "storefrontAdsAdmin" },
    { "path": "/admin/vendors", "implementation": "adminVendors" },
    { "path": "/admin/shoppers", "implementation": "adminShoppers" },
    { "path": "/admin/orders", "implementation": "adminOrders" },
    { "path": "/favourites", "template": "shellCopy", "screen": "favourites" },
    { "path": "/orders", "implementation": "orders" },
    { "path": "/orders/track", "implementation": "orderTracking" },
    { "path": "/orders/track/:orderId", "implementation": "orderTracking" },
    { "path": "/vendor/orders", "implementation": "vendorOrders" },
    { "path": "/vendor/tables", "implementation": "tableManagement" },
    { "path": "/vendor/roles", "implementation": "rolesAdmin" },
    { "path": "/admin/roles", "implementation": "rolesAdmin" },
    { "path": "/admin/portal-users/:portalUserId/role-assignments", "implementation": "userRoleAssignments" },
    { "path": "/vendor/floor", "implementation": "tableFloorPlan" },
    { "path": "/communication", "template": "shellCopy", "screen": "communication" },
    { "path": "/support", "template": "shellCopy", "screen": "support" },
    { "path": "/legal/privacy", "template": "shellCopy", "screen": "legalPrivacy" },
    { "path": "/legal/terms", "template": "shellCopy", "screen": "legalTerms" }
  ]
}
