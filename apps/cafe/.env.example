# Copy to .env.development (gitignored) for local overrides.
#
# Stable defaults: tenant t1 has seeded catalog + cafe lookups.
# Leave VITE_COMMERCE_API_URL unset in dev — Vite proxies /api and /media to :5055.

# VITE_COMMERCE_API_URL=http://localhost:5055
VITE_COMMERCE_TENANT_ID=t1
VITE_STOREFRONT_MODE=isolated_shop
VITE_STOREFRONT_VERTICAL=cafe
VITE_CATALOG_APPLICATION_TYPE_ID=app_cafe
