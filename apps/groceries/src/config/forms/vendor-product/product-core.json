{
  "id": "vendor-product-core",
  "title": "Product",
  "layout": {
    "type": "stack",
    "axis": "vertical",
    "gap": "0.85rem",
    "children": [
      {
        "type": "region",
        "name": "Basics",
        "children": [
          { "type": "field", "fieldId": "titleDisplay" },
          { "type": "field", "fieldId": "slug" },
          { "type": "field", "fieldId": "status" },
          { "type": "field", "fieldId": "productTypeId" },
          { "type": "field", "fieldId": "primaryCategoryId" }
        ]
      },
      {
        "type": "region",
        "name": "List pricing (catalog card)",
        "children": [
          { "type": "field", "fieldId": "currency" },
          { "type": "field", "fieldId": "minPriceRupees" }
        ]
      }
    ]
  },
  "fields": {
    "titleDisplay": {
      "binding": "core.titleDisplay",
      "widget": "text",
      "label": "Title",
      "default": "",
      "rules": [{ "kind": "required" }]
    },
    "slug": {
      "binding": "core.slug",
      "widget": "text",
      "label": "Slug",
      "default": ""
    },
    "status": {
      "binding": "core.status",
      "widget": "select",
      "label": "Status",
      "props": {
        "options": [
          { "value": "draft", "label": "Draft" },
          { "value": "active", "label": "Active (storefront)" }
        ]
      },
      "default": "draft"
    },
    "productTypeId": {
      "binding": "core.productTypeId",
      "widget": "select",
      "label": "Product type",
      "description": "Options load from Commerce.Api lookup `product_types` (see lookup-form-bindings.json).",
      "default": "",
      "props": { "options": [] }
    },
    "primaryCategoryId": {
      "binding": "core.primaryCategoryId",
      "widget": "select",
      "label": "Primary category",
      "description": "Options load from Commerce.Api lookup `product_categories` (mirrors catalog categories).",
      "default": "",
      "props": { "options": [] }
    },
    "currency": {
      "binding": "core.currency",
      "widget": "text",
      "label": "Currency",
      "default": "INR",
      "props": { "maxLength": 8 }
    },
    "minPriceRupees": {
      "binding": "core.minPriceRupees",
      "widget": "text",
      "label": "From price (major units)",
      "description": "Shown on cards; stored as minor units on save.",
      "default": ""
    }
  }
}
