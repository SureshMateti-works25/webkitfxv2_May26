{
  "id": "vendor-product-core",
  "title": "Product",
  "layout": {
    "type": "stack",
    "axis": "vertical",
    "gap": "0.85rem",
    "children": [
      {
        "type": "region",
        "name": "Basics",
        "children": [
          { "type": "field", "fieldId": "titleDisplay" },
          { "type": "field", "fieldId": "slug" },
          { "type": "field", "fieldId": "status" },
          { "type": "field", "fieldId": "applicationTypeId" },
          { "type": "field", "fieldId": "productDepartmentId" },
          { "type": "field", "fieldId": "productCategoryId" }
        ]
      },
      {
        "type": "region",
        "name": "List pricing (catalog card)",
        "children": [
          { "type": "field", "fieldId": "currency" },
          { "type": "field", "fieldId": "minPriceRupees" }
        ]
      }
    ]
  },
  "fields": {
    "titleDisplay": {
      "binding": "core.titleDisplay",
      "widget": "text",
      "label": "Title",
      "default": "",
      "rules": [{ "kind": "required" }]
    },
    "slug": {
      "binding": "core.slug",
      "widget": "text",
      "label": "Slug",
      "default": ""
    },
    "status": {
      "binding": "core.status",
      "widget": "select",
      "label": "Status",
      "props": {
        "options": [
          { "value": "draft", "label": "Draft" },
          { "value": "active", "label": "Active (storefront)" }
        ]
      },
      "default": "draft"
    },
    "applicationTypeId": {
      "binding": "core.productTypeId",
      "widget": "select",
      "label": "Application type",
      "description": "Which application or vertical this product belongs to (stored as product type on the server).",
      "default": "",
      "props": { "options": [] }
    },
    "productDepartmentId": {
      "binding": "core.productDepartmentId",
      "widget": "select",
      "label": "Product department",
      "description": "Narrows the category list; not stored on the product row.",
      "default": "",
      "props": { "options": [] }
    },
    "productCategoryId": {
      "binding": "core.primaryCategoryId",
      "widget": "select",
      "label": "Product category",
      "description": "Storefront aisle / category tile (Commerce.Api primary category link).",
      "default": "",
      "props": { "options": [] }
    },
    "currency": {
      "binding": "core.currency",
      "widget": "text",
      "label": "Currency",
      "default": "INR",
      "props": { "maxLength": 8 }
    },
    "minPriceRupees": {
      "binding": "core.minPriceRupees",
      "widget": "text",
      "label": "From price (major units)",
      "description": "Shown on cards; stored as minor units on save.",
      "default": ""
    }
  }
}
