{
  "id": "vendor-product-enquiries",
  "title": "Enquiries",
  "layout": {
    "type": "stack",
    "axis": "vertical",
    "gap": "0.85rem",
    "children": [
      {
        "type": "region",
        "name": "Engagement (stub)",
        "children": [
          { "type": "field", "fieldId": "note" },
          { "type": "field", "fieldId": "openCount" }
        ]
      }
    ]
  },
  "fields": {
    "note": {
      "binding": "commerce.enquiries.note",
      "widget": "textarea",
      "label": "Vendor note",
      "props": { "rows": 3 },
      "default": ""
    },
    "openCount": {
      "binding": "commerce.enquiries.openCount",
      "widget": "text",
      "label": "Open count (informational)",
      "default": "0"
    }
  }
}
