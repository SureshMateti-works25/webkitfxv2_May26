{
  "id": "vendor-product-pricing",
  "title": "Price & offers",
  "layout": {
    "type": "stack",
    "axis": "vertical",
    "gap": "0.85rem",
    "children": [
      {
        "type": "region",
        "name": "Promotions",
        "children": [
          { "type": "field", "fieldId": "offerLabel" },
          { "type": "field", "fieldId": "promoEndsAt" }
        ]
      }
    ]
  },
  "fields": {
    "offerLabel": {
      "binding": "commerce.pricing.offerLabel",
      "widget": "text",
      "label": "Offer label",
      "description": "e.g. Pongal 15% off",
      "default": ""
    },
    "promoEndsAt": {
      "binding": "commerce.pricing.promoEndsAt",
      "widget": "text",
      "label": "Promo end (ISO date)",
      "default": ""
    }
  }
}
